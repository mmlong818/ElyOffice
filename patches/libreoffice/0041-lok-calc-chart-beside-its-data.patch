+/// The last column from nCol spanning nWidth twips, if any.
+std::optional<SCCOL> lcl_Across(const ScDocument& rDoc, SCTAB nTab, SCCOL nCol, tools::Long nWidth)
+{
+    tools::Long nSum = 0;
+    for (SCCOL n = nCol; n <= rDoc.MaxCol(); ++n)
+        if ((nSum += rDoc.GetColWidth(n, nTab)) >= nWidth)
+            return n;
+    return std::nullopt;
+}
+
+/// The last row from nRow spanning nHeight twips, if any.
+std::optional<SCROW> lcl_Down(const ScDocument& rDoc, SCTAB nTab, SCROW nRow, tools::Long nHeight)
+{
+    tools::Long nSum = 0;
+    for (SCROW n = nRow; n <= rDoc.MaxRow(); ++n)
+        if ((nSum += rDoc.GetRowHeight(n, nTab)) >= nHeight)
+            return n;
+    return std::nullopt;
+}
+
+/// LOK: empty cells right of rData, else below, left, above.
+std::optional<Point> lcl_EmptyBeside(const ScDocument& rDoc, const ScRange& rData, const Size& rSize)
+{
+    const SCTAB nTab = rData.aStart.Tab();
+    const tools::Long nWidth = o3tl::convert(rSize.Width(), o3tl::Length::mm100, o3tl::Length::twip);
+    const tools::Long nHeight = o3tl::convert(rSize.Height(), o3tl::Length::mm100, o3tl::Length::twip);
+    // Merged cells take their whole area, anchor or not.
+    const auto free = [&](SCCOL nCol1, SCROW nRow1, SCCOL nCol2, SCROW nRow2) {
+        return rDoc.IsBlockEmpty(nCol1, nRow1, nCol2, nRow2, nTab)
+            && !rDoc.HasAttrib(nCol1, nRow1, nTab, nCol2, nRow2, nTab, HasAttrFlags::Merged | HasAttrFlags::Overlapped);
+    };
+    const auto at = [&](SCCOL nCol, SCROW nRow) { return rDoc.GetMMRect(nCol, nRow, nCol, nRow, nTab).TopLeft(); };
+    const SCROW nTop = rData.aStart.Row();
+    const SCCOL nLeft = rData.aStart.Col();
+    // Sideways scans share rows; vertical scans share columns.
+    if (const auto oBottom = lcl_Down(rDoc, nTab, nTop, nHeight))
+    {
+        for (SCCOL nCol = rData.aEnd.Col() + 2; nCol <= rDoc.MaxCol(); ++nCol)
+            if (const auto oRight = lcl_Across(rDoc, nTab, nCol, nWidth); oRight && free(nCol, nTop, *oRight, *oBottom))
+                return at(nCol, nTop);
+    }
+    const auto oRight = lcl_Across(rDoc, nTab, nLeft, nWidth);
+    for (SCROW nRow = rData.aEnd.Row() + 2; oRight && nRow <= rDoc.MaxRow(); ++nRow)
+        if (const auto oBottom = lcl_Down(rDoc, nTab, nRow, nHeight); oBottom && free(nLeft, nRow, *oRight, *oBottom))
+            return at(nLeft, nRow);
+    if (const auto oBottom = lcl_Down(rDoc, nTab, nTop, nHeight))
+    {
+        for (SCCOL nCol = nLeft - 2; nCol >= 0; --nCol)
+            if (const auto oEnd = lcl_Across(rDoc, nTab, nCol, nWidth); oEnd && *oEnd < nLeft - 1 && free(nCol, nTop, *oEnd, *oBottom))
+                return at(nCol, nTop);
+    }
+    for (SCROW nRow = nTop - 2; oRight && nRow >= 0; --nRow)
+        if (const auto oEnd = lcl_Down(rDoc, nTab, nRow, nHeight); oEnd && *oEnd < nTop - 1 && free(nLeft, nRow, *oRight, *oEnd))
+            return at(nLeft, nRow);
+    // Last, any chart-sized empty block, row bands first.
+    for (SCROW nRow = 0; const auto oBottom = lcl_Down(rDoc, nTab, nRow, nHeight); nRow = *oBottom + 1)
+        for (SCCOL nCol = 0; const auto oEnd = lcl_Across(rDoc, nTab, nCol, nWidth); nCol = *oEnd + 1)
+            if (free(nCol, nRow, *oEnd, *oBottom))
+                return at(nCol, nRow);
+    return std::nullopt;
+}
