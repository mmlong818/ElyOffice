+/// Implements getCommandValues(".uno:CharFonts"): empty when mixed.
+void GetCharFonts(tools::JsonWriter& rJsonWriter, SwDocShell* pDocShell)
+{
+    SwWrtShell* pWrtShell = pDocShell->GetWrtShell();
+    if (!pWrtShell)
+        return;
+    SfxItemSetFixed<RES_CHRATR_FONT, RES_CHRATR_FONT, RES_CHRATR_CJK_FONT, RES_CHRATR_CJK_FONT>
+        aSet(pWrtShell->GetAttrPool());
+    // Past Writer's lookup limit nothing is read.
+    if (!pWrtShell->GetCurAttr(aSet))
+    {
+        rJsonWriter.put("unread", true);
+        return;
+    }
+    for (const auto& [pName, nWhich] :
+         { std::pair<const char*, sal_uInt16>("western", RES_CHRATR_FONT),
+           std::pair<const char*, sal_uInt16>("asian", RES_CHRATR_CJK_FONT) })
+    {
+        if (aSet.GetItemState(nWhich) == SfxItemState::INVALID)
+            rJsonWriter.put(pName, u""_ustr);
+        else
+            rJsonWriter.put(pName,
+                            static_cast<const SvxFontItem&>(aSet.Get(nWhich)).GetFamilyName());
+    }
+}
