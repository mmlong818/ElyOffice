     Color maSavedBackgroundColor;
-#if defined(MACOSX)
+#if defined(MACOSX) || defined(_WIN32)
     unsigned char* mpBuffer;
     Size maBufferSize;
 #endif
@@ -103,7 +103,7 @@ public:
         , maVirtualDevice(
               CoreGraphics::getiOSGraphicsData(pBuffer, rSlideSize.Width(), rSlideSize.Height()),
               Size(1, 1), DeviceFormat::WITHOUT_ALPHA)
-#elif defined(MACOSX)
+#elif defined(MACOSX) || defined(_WIN32)
         , mpBuffer(pBuffer)
         , maBufferSize(rSlideSize)
         , maVirtualDevice(DeviceFormat::WITH_ALPHA)
@@ -123,8 +123,8 @@ public:
 
         maVirtualDevice->SetBackground(Wallpaper(COL_TRANSPARENT));
 
-#if defined(MACOSX)
-        // Aqua devices cannot paint client buffers: paint, then copy.
+#if defined(MACOSX) || defined(_WIN32)
+        // No client buffers here: paint, then copy.
         (void)rScale;
         maVirtualDevice->SetOutputSizePixel(rSlideSize);
 #else
@@ -155,7 +155,7 @@ public:
 #ifdef IOS
         CoreGraphics::CGContextRelease(maVirtualDevice->GetSystemGfxData().rCGContext);
 #endif
-#if defined(MACOSX)
