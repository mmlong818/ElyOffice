                                  aParam.nCol2, aParam.nRow2, nTab ) )
         {
-            if (!bHeader)
+            if (!bHeader && comphelper::LibreOfficeKit::isActive())
+            {
+                // LOK asks nothing: the first row heads, the box's default.
+                pDBData->SetHeader( true );
+                ApplyAutoFilter(*pDocSh, rViewData, pDBData, nRow, nTab, aParam);
